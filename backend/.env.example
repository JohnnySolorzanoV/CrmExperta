POE_API_KEY=tu_api_key_de_poe
POE_MODEL=Gemini-2.5-Pro
JWT_SECRET=crm-experta-secreto-temporal
DATABASE_URL=postgres://postgres:admin1234@localhost:5433/crm_experta
DATABASE_URL_TEST=postgres://postgres:admin1234@localhost:5433/crm_experta_test

# Email saliente por SMTP (alternativa simple recomendada)
# Para Gmail: usa SMTP_USER con tu correo y SMTP_PASS con App Password de Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_SENDER_EMAIL=tu_correo@gmail.com

API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Almacenamiento de archivos.
# Deja todas las SPACES_* vacías (o STORAGE_DRIVER sin definir) para usar el
# sistema de archivos local (backend/uploads). Para DigitalOcean Spaces define:
# STORAGE_DRIVER=spaces
# SPACES_BUCKET=mi-bucket
# SPACES_REGION=nyc3
# SPACES_ENDPOINT=https://mi-bucket.nyc3.digitaloceanspaces.com
# SPACES_KEY=tu_access_key
# SPACES_SECRET=tu_secret_key
STORAGE_DRIVER=local
